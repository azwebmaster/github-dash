# Copy to .env or export in your shell
GITHUB_TOKEN=
GITHUB_REPO=owner/repo
PORT=3847
# Actions workflow file that creates GitHub Releases (CLI: --release-workflow). Default release.yml.
RELEASE_WORKFLOW=release.yml
# Claude Agent SDK — required for POST /api/workflows/:id/analyze (failure → likely PR/author).
ANTHROPIC_API_KEY=
# Optional model override for analysis (default: sonnet).
# CLAUDE_MODEL=sonnet
# In-memory cache TTL for GitHub responses (ms). Default 5 minutes. Later: Redis / remote.
CACHE_TTL_MS=300000
# Log cache HIT/MISS/WAIT lines: CACHE_DEBUG=1
# Max pages per list fetch (100 items/page). Caps huge list windows (e.g. busy PR histories).
# Workflow runs use a separate count limit (50–500) instead of days.
GITHUB_MAX_PAGES=20
