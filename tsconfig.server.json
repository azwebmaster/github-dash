{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "sourceMap": true,
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["src/server/**/*", "src/cli.ts", "src/shared/**/*"],
  "exclude": ["src/client/**/*", "src/server/cli-dev.ts"]
}
